rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function linkId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

    // my own record: my ID and name
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ID lookup: anyone signed in can look up ONE id (no listing), only the owner can write
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }

    // friend link = invite + accept. Only the two people in it can see it.
    match /links/{id} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid in request.resource.data.members
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && id == linkId(request.resource.data.members[0], request.resource.data.members[1]);
      // only the invited person can accept, and only the status can change
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // daily percentages: me, or a friend who accepted
    match /progress/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/links/$(linkId(request.auth.uid, uid))).data.status == 'accepted'
      );
      allow write: if signedIn() && request.auth.uid == uid && request.resource.data.days.size() <= 120;
    }
  }
}
